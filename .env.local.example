# Copy this file to `.env.local` in the project root, then fill in your values.
# After saving, restart the dev server: stop it (Ctrl+C) and run `npm run dev` again.

# 1. Open https://supabase.com/dashboard
# 2. Select project "Real_Cost_of_Concerts"
# 3. Go to Connect or Settings → API Keys
# 4. Copy Project URL below:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# 5. Copy the publishable key (or legacy anon public key). Do NOT use service role / secret keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Ticketmaster Discovery API (server-only). Free key: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=YOUR_TICKETMASTER_API_KEY
